<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.saeldrit.geai</id>
    <name>geai</name>
    <vendor>saeldrit</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!--
      JCEF (Chromium-based browser) powers the full-fidelity HTML chat UI.
      Android Studio and some slim JBR builds may omit the native libraries;
      when JCEF is unavailable the plugin degrades to the Swing fallback
      (GeaiChatPanel) which looks and works differently.
      Declaring the dependency here ensures the platform loads the JCEF module
      when the host IDE ships it.
    -->
    <depends optional="true" config-file="geai-jcef.xml">com.intellij.modules.jcef</depends>
    <!--
      Optional dependency on the Java plugin: enables psi: anchor resolution and live PSI-based
      structure navigation (classes, methods, inheritance) behind graph_query / graph_neighbors /
      context_bundle. geai loads and works without it — psi: anchors and class structure degrade
      to a clean error, and the context bundle falls back to spec- and file-level context.
    -->
    <depends optional="true" config-file="geai-java.xml">com.intellij.modules.java</depends>

    <!-- IDE product compatibility — geai works on any IntelliJ-platform IDE -->
    <productDescriptor code="IC" name="IntelliJ IDEA"/>
    <productDescriptor code="PC" name="PyCharm"/>
    <productDescriptor code="AI" name="Android Studio"/>
    <productDescriptor code="GO" name="GoLand"/>
    <productDescriptor code="WS" name="WebStorm"/>
    <productDescriptor code="CL" name="CLion"/>
    <productDescriptor code="RD" name="Rider"/>
    <productDescriptor code="DB" name="DataGrip"/>
    <productDescriptor code="PS" name="PhpStorm"/>
    <productDescriptor code="RM" name="RubyMine"/>

    <resource-bundle>messages.GeaiBundle</resource-bundle>

    <actions>
        <action id="geai.connectToHub"
                class="com.github.saeldrit.geai.hub.ConnectToHubAction"
                text="Geai: Connect to Hub"
                description="Connect this IDE as a Spoke to the geai Hub orchestrator">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="geai.runBenchmark"
                class="com.github.saeldrit.geai.benchmark.GeaiRunBenchmarkAction"
                text="Geai: Run A/B Benchmark"
                description="Run the same task under baseline vs GRACE and write a token/cost comparison report">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <projectListeners>
        <!-- Captures stdout/stderr of every Run/Debug configuration from the moment it starts,
             so the read_run_output tool can serve the tail — the agent's eyes on program output. -->
        <listener class="com.github.saeldrit.geai.tools.system.RunOutputExecutionListener"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Geai Hub" displayType="BALLOON"/>
        <postStartupActivity implementation="com.github.saeldrit.geai.hub.HubStartupActivity"/>
        <toolWindow
            factoryClass="com.github.saeldrit.geai.toolWindow.GeaiToolWindowFactory"
            id="Geai"
            anchor="right"
            icon="/icons/geaiToolWindow.svg"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.saeldrit.geai.settings.GeaiSettingsConfigurable"
            id="com.github.saeldrit.geai.settings"
            displayName="Geai"/>
    </extensions>
</idea-plugin>