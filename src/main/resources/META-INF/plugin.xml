<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.saeldrit.geai</id>
    <name>geai</name>
    <vendor>saeldrit</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.GeaiBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            factoryClass="com.github.saeldrit.geai.toolWindow.GeaiToolWindowFactory"
            id="Geai"
            anchor="right"
            icon="/icons/geaiToolWindow.svg"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.saeldrit.geai.settings.GeaiSettingsConfigurable"
            id="com.github.saeldrit.geai.settings"
            displayName="Geai"/>
    </extensions>
</idea-plugin>
