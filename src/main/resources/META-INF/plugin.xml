<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.saeldrit.geai</id>
    <name>geai</name>
    <vendor>saeldrit</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!--
      Optional dependency on the Java plugin: enables psi: anchor resolution and full PSI-based
      graph indexing (FILE→class→method, inheritance). geai loads and works without it — psi:
      anchors degrade to a clean error, graph_reindex falls back to the spec-only subgraph.
    -->
    <depends optional="true" config-file="geai-java.xml">com.intellij.modules.java</depends>

    <resource-bundle>messages.GeaiBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            factoryClass="com.github.saeldrit.geai.toolWindow.GeaiToolWindowFactory"
            id="Geai"
            anchor="right"
            icon="/icons/geaiToolWindow.svg"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.saeldrit.geai.settings.GeaiSettingsConfigurable"
            id="com.github.saeldrit.geai.settings"
            displayName="Geai"/>
    </extensions>
</idea-plugin>
